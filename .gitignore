# Home Assistant runtime (config structure is committed; runtime state is not)
homeassistant/*
!homeassistant/.gitkeep
!homeassistant/configuration.yaml
!homeassistant/automations.yaml
!homeassistant/scripts.yaml
!homeassistant/scenes.yaml
!homeassistant/themes/
!homeassistant/dashboards/
homeassistant/secrets.yaml
homeassistant/.storage/
homeassistant/.cloud/
homeassistant/*.db
homeassistant/*.db-*
homeassistant/*.log*
homeassistant/tts/
homeassistant/deps/
homeassistant/image/

# Mosquitto runtime
mosquitto/config/passwd
mosquitto/data/*
mosquitto/log/*
!mosquitto/data/.gitkeep
!mosquitto/log/.gitkeep

# Zigbee2MQTT runtime (config structure is committed; state/coordinator backups are not)
zigbee2mqtt/data/*
!zigbee2mqtt/data/.gitkeep
!zigbee2mqtt/data/configuration.yaml

# Asterisk (SIP). Commit roster, generator and the static rtp.conf override;
# everything the container or generator writes stays out (keys, AMI/SIP passwords).
asterisk/config/*
!asterisk/config/asterisk/
asterisk/config/asterisk/*
!asterisk/config/asterisk/custom/
asterisk/config/asterisk/custom/*
!asterisk/config/asterisk/custom/rtp.conf
asterisk/sip-core-options.yaml
asterisk/media/

# Caddy runtime (issued certs, ACME account key)
caddy/data/
caddy/config/

# Secrets / env
.env.secrets
*.token

# OS/editor
.DS_Store
*.swp

# Owner's UI screenshots (feedback material) — never commit
UI Photos(No Commit)/
