# Non-secret environment for the stack. Committed — do not put credentials here.
TZ=Asia/Muscat
PUID=1000
PGID=1000

# Zigbee coordinator serial path. Leave as-is until the dongle is plugged in,
# then set to its /dev/serial/by-id/... path (never /dev/ttyUSBx — it renumbers
# on reboot). Find it with: ls -l /dev/serial/by-id/
ZIGBEE_DONGLE_PATH=/dev/serial/by-id/CHANGEME
