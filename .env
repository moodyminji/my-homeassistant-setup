# Non-secret environment for the stack. Committed — do not put credentials here.
TZ=Asia/Muscat
PUID=1000
PGID=1000

# Zigbee coordinator serial path (Sonoff ZBDongle-P). Always the
# /dev/serial/by-id/... path, never /dev/ttyUSBx — that renumbers on reboot.
# Find it with: ls -l /dev/serial/by-id/
ZIGBEE_DONGLE_PATH=/dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_3e71154e4f15f011993fe074b887153e-if00-port0

# Public name the tablets use, e.g. majlis-home.duckdns.org. Caddy serves it with a real
# Let's Encrypt certificate; in DuckDNS, point it at this host's LAN IP (192.168.100.49).
SITE_HOST=minjihome.duckdns.org

# Remote access is Twingate (its tokens are in .env.secrets). The settings below are
# only for the WireGuard FALLBACK, which is not started by default (compose profile
# "wireguard"). WG_HOST is a SECOND DuckDNS name, under the same DuckDNS
# account/token, that follows the house's public IP (the duckdns-wg service updates
# it). Create it at duckdns.org first. Do not reuse SITE_HOST here.
WG_HOST=minjihome-wg.duckdns.org
# UDP port; forward it on the router to 192.168.100.49.
WG_PORT=51820
# One VPN profile per device, comma-separated, letters and digits only. Adding a
# name and recreating the container adds a profile without touching the others.
WG_PEERS=phone1,phone2,laptop
