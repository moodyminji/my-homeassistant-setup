# Copy to .env.local (gitignored) and fill in with real values.
# Get a long-lived access token from your HA profile page:
# http://192.168.100.199:8123/profile/security -> "Long-Lived Access Tokens"
#
# Use the IP, not majlis.local — this network's router doesn't forward mDNS
# multicast between Wi-Fi and wired segments, so .local never resolves off
# the host itself. See Claude.md §3.

VITE_HA_URL=http://192.168.100.199:8123
VITE_HA_TOKEN=
