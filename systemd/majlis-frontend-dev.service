[Unit]
Description=Majlis frontend Vite dev server
After=network-online.target majlis-compose.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/moodyminji/majlis/frontend
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=5
User=moodyminji
Group=moodyminji
Environment=HOME=/home/moodyminji

[Install]
WantedBy=multi-user.target
