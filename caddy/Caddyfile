{
	# CasaOS already owns :80, and the DNS-01 challenge needs no inbound port,
	# so skip Caddy's HTTP->HTTPS redirect listener. Clients go straight to https.
	auto_https disable_redirects
}

{$SITE_HOST} {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}

	# SIP-over-WebSocket for the intercom: TLS ends here, Asterisk speaks plain ws
	# on 8088 (the WebRTC media itself is still DTLS-SRTP end to end).
	handle /ws {
		reverse_proxy 127.0.0.1:8088
	}

	handle {
		reverse_proxy 127.0.0.1:8123
	}
}
