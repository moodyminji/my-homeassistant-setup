# Copy to .env.secrets (gitignored) and fill in. Never commit the real file.
DUCKDNS_TOKEN=


# Twingate connector (remote access). From the Twingate admin console:
# Remote Networks -> your network -> Add Connector -> Docker -> Generate tokens.
# TWINGATE_NETWORK is the part before .twingate.com in your admin address.
TWINGATE_NETWORK=
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=
